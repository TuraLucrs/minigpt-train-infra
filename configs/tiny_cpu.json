{
  "model": {
    "block_size": 64,
    "n_layer": 2,
    "n_head": 2,
    "n_embd": 64,
    "dropout": 0.1
  },
  "train": {
    "data_path": "data/tiny_corpus.txt",
    "out_dir": "runs/tiny_cpu",
    "device": "cpu",
    "precision": "fp32",
    "seed": 1337,
    "batch_size": 8,
    "gradient_accumulation_steps": 2,
    "max_steps": 30,
    "learning_rate": 0.001,
    "min_learning_rate": 0.0001,
    "warmup_steps": 5,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.95,
    "adam_eps": 0.00000001,
    "grad_clip": 1.0,
    "val_fraction": 0.1,
    "eval_interval": 10,
    "eval_batches": 5,
    "log_interval": 1,
    "checkpoint_interval": 15
  }
}
