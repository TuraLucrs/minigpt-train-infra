{
  "model": {
    "block_size": 128,
    "n_layer": 4,
    "n_head": 4,
    "n_embd": 128,
    "dropout": 0.1
  },
  "train": {
    "data_path": "data/tiny_corpus.txt",
    "out_dir": "runs/tiny_gpu",
    "device": "auto",
    "precision": "bf16",
    "seed": 1337,
    "batch_size": 16,
    "gradient_accumulation_steps": 4,
    "max_steps": 200,
    "learning_rate": 0.0006,
    "min_learning_rate": 0.00006,
    "warmup_steps": 20,
    "weight_decay": 0.01,
    "beta1": 0.9,
    "beta2": 0.95,
    "adam_eps": 0.00000001,
    "grad_clip": 1.0,
    "val_fraction": 0.1,
    "eval_interval": 50,
    "eval_batches": 10,
    "log_interval": 5,
    "checkpoint_interval": 100
  }
}
